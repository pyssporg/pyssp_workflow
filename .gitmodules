# Development tree. Every entry below is linked under 3rd_party/, and the
# gitlink in the parent commit pins the revision this package was tested with.
#
# To bump one: check out the new revision inside the submodule, then
# `git add 3rd_party/<name>`. Change a URL only with
# `git submodule set-url 3rd_party/<name> <url>`.
#
# See docs/breakdown/05-operation/submodules.md.

[submodule "3rd_party/pyssp_standard"]
	path = 3rd_party/pyssp_standard
	url = https://github.com/jkCXf9X4/pyssp_standard.git

[submodule "3rd_party/pyssp_simulate"]
	path = 3rd_party/pyssp_simulate
	url = https://github.com/pyssporg/pyssp_simulate.git
	branch = main

[submodule "3rd_party/pyssp_sysml2"]
	path = 3rd_party/pyssp_sysml2
	url = https://github.com/pyssporg/pyssp_sysml2.git
	branch = main

[submodule "3rd_party/pyssp_vv"]
	path = 3rd_party/pyssp_vv
	url = https://github.com/pyssporg/pyssp_vv.git
	branch = main

[submodule "3rd_party/sequence_extensions"]
	path = 3rd_party/sequence_extensions
	url = https://github.com/jkCXf9X4/sequence_extensions.git
	branch = main
